{
  "name": "@crawlora-org/gosugamers",
  "version": "0.1.0",
  "description": "Crawlora GosuGamers API client with 17 endpoints for esports matches, results, tournaments, games, news, and articles",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=gosugamers-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-gosugamers/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "gosugamers", "gosugamers-api", "gosugamers-scraper", "gosugamers-data", "gosugamers-esports-matches", "gosugamers-results", "gosugamers-tournaments", "gosugamers-games", "gosugamers-news", "gosugamers-articles"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-gosugamers",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
